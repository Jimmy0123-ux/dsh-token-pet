{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-review-record.schema.v2.json",
  "title": "Token Pet single-form action review record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordStatus", "action", "pressureBandIndependent", "form", "model", "jobId", "seed", "finalPrompt", "negativePrompt", "references", "sourceVideo", "actualFPS", "acceptedFrames", "qcResults", "decision", "reviewer", "createdAt"],
  "properties": {
    "$schema":{"type":"string"},
    "schemaVersion":{"const":2},
    "recordStatus":{"enum":["draft-template","pending","reviewed"]},
    "action":{"enum":["idle","working","eating","digesting","warning","evolve","click","archive","tool-success","tool-failure","prompt-enhancing","prompt-ready"]},
    "pressureBandIndependent":{"const":true},
    "form":{"const":"qpet"},
    "model":{"type":"string","minLength":1},
    "jobId":{"type":"string","minLength":1},
    "seed":{"oneOf":[{"type":"integer","minimum":0},{"type":"string","minLength":1}]},
    "finalPrompt":{"type":"string","minLength":1},
    "negativePrompt":{"type":"string","minLength":1},
    "references":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["role","path","sha256"],"properties":{"role":{"enum":["identity","action-start-state","prop"]},"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "sourceVideo":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "actualFPS":{"type":"number","minimum":0},
    "acceptedFrames":{"type":"integer","minimum":0},
    "qcResults":{"type":"object","additionalProperties":false,"required":["decodable","durationAndDimensionsMatch","noAudio","identityPass","frontViewPass","propCleanupPass","loopOrReturnToIdlePass","noTextLogoWatermarkUiPass","notes"],"properties":{"decodable":{"type":["boolean","null"]},"durationAndDimensionsMatch":{"type":["boolean","null"]},"noAudio":{"type":["boolean","null"]},"identityPass":{"type":["boolean","null"]},"frontViewPass":{"type":["boolean","null"]},"propCleanupPass":{"type":["boolean","null"]},"loopOrReturnToIdlePass":{"type":["boolean","null"]},"noTextLogoWatermarkUiPass":{"type":["boolean","null"]},"notes":{"type":"array","items":{"type":"string"}}}},
    "decision":{"enum":["pending","approved","rejected","revise"]},
    "reviewer":{"type":"string","minLength":1},
    "createdAt":{"type":"string","format":"date-time"}
  }
}
